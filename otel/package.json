{
  "name": "grocery-ops-otel",
  "private": true,
  "type": "module",
  "description": "SDK do OpenTelemetry carregado antes do servidor (node --import ./otel/instrumentation.mjs). Fica fora do bundle do Nitro para instrumentar o node:http desde o início.",
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "import-in-the-middle": "3.6.0"
  }
}
